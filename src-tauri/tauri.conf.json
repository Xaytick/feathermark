{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FeatherMark",
  "version": "0.5.2",
  "identifier": "com.feathermark.editor",
  "build": {
    "beforeDevCommand": "node build.mjs",
    "beforeBuildCommand": "node build.mjs",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FeatherMark",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": false,
        "hiddenTitle": true,
        "backgroundColor": "#f7f7f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost http: https: file:; font-src 'self' data: blob:; media-src 'self' blob: data:; frame-src 'self'; connect-src 'self' ipc: http://ipc.localhost tauri: asset: blob: data: http: https:; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/welcome.md": "welcome.md"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor"
      }
    ]
  }
}